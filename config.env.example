# ── PR Risk Analyser — Example Configuration ─────────────────────────────────
# Copy this file to config.env and fill in your project values:
#   cp config.env.example config.env
#
# Or run the interactive wizard:
#   bash scripts/init.sh

# ── Git Provider ──────────────────────────────────────────────────────────────
# Supported: bitbucket-server | bitbucket-cloud | github | gitlab
GIT_PROVIDER=bitbucket-server

# Base URL for repo cloning (SSH or HTTPS — everything BEFORE the repo name)
#   Bitbucket Server : ssh://git@bitbucket.example.com:7999/PROJECT
#   GitHub           : git@github.com:ORG
#   GitLab           : git@gitlab.com:GROUP
REPO_BASE_URL=ssh://git@bitbucket.example.com:7999/MYPROJECT

# ── Services ──────────────────────────────────────────────────────────────────
# Discovery mode:
#   manual → uses the SERVICES list below
#   auto   → scans workspace for cloned .git repos on each run
SERVICE_DISCOVERY_MODE=manual

# Comma-separated repo names (used when SERVICE_DISCOVERY_MODE=manual)
SERVICES=my-service-a,my-service-b,my-frontend

# ── JIRA ──────────────────────────────────────────────────────────────────────
# Project key prefix(es), comma-separated (e.g., PROJ or PROJ,INFRA)
JIRA_PROJECT_KEYS=PROJ

# Commit filter mode:
#   any  → Fetch commits mentioning AT LEAST ONE of the provided ticket IDs
#   only → Fetch commits mentioning ONLY the provided ticket IDs (default)
COMMIT_FILTER_MODE=any
# NOTE: Jira + Confluence access is handled by the Atlassian MCP integration
# (configured in VS Code). No credentials needed here.
# ── Test Automation Repo ──────────────────────────────────────────────────────
# Repo name of the test automation suite (uses same REPO_BASE_URL as services)
# Leave blank to disable test selection (Mode 2)
TEST_REPOS=my-automated-tests

# ── Performance ───────────────────────────────────────────────────────────────
MAX_PARALLEL=4
REF_CACHE_TTL=600
