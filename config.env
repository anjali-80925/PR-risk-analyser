# ── PR Risk Analyser — Configuration ──────────────────────────────────────────
# Generated by: bash scripts/init.sh
# Docs: see readme.md

# ── Git Provider ──────────────────────────────────────────────────────────────
# Supported: bitbucket-server | bitbucket-cloud | github | gitlab
GIT_PROVIDER=bitbucket-server

# Base URL for repo cloning (SSH or HTTPS)
#   Bitbucket Server : ssh://git@bitbucket.example.com:7999/PROJECT
#   GitHub           : git@github.com:ORG
#   GitLab           : git@gitlab.com:GROUP
REPO_BASE_URL=ssh://git@bitbucket.tools.3stripes.net:7999/cms

# ── Services ──────────────────────────────────────────────────────────────────
# Discovery mode: manual (uses SERVICES list) | auto (scans workspace .git dirs)
SERVICE_DISCOVERY_MODE=manual

# Comma-separated repo names (used when SERVICE_DISCOVERY_MODE=manual)
SERVICES=content-automation-task,strapi-cms-v4,mfe-content-editor,mfe-content-overview,mfe-publish-hub,dam-lambda

# ── JIRA ──────────────────────────────────────────────────────────────────────
# Project key prefix(es), comma-separated
JIRA_PROJECT_KEYS=DBCCPMCMS

# ── Performance ───────────────────────────────────────────────────────────────
MAX_PARALLEL=4
REF_CACHE_TTL=600
