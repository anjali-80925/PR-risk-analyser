# ── PR Risk Analyser — Configuration ──────────────────────────────────────────
# Generated by: bash scripts/init.sh
# Docs: see readme.md

# ── Git Provider ──────────────────────────────────────────────────────────────
# Supported: bitbucket-server | bitbucket-cloud | github | gitlab
GIT_PROVIDER=bitbucket-server

# Base URL for repo cloning (SSH or HTTPS)
REPO_BASE_URL=ssh://git@bitbucket.tools.3stripes.net:7999/b2bdtb

# ── Services ──────────────────────────────────────────────────────────────────
# Discovery mode: manual (uses SERVICES list) | auto (scans workspace .git dirs)
SERVICE_DISCOVERY_MODE=manual

# Comma-separated repo names (used when SERVICE_DISCOVERY_MODE=manual)
SERVICES=coi-offline-download-trigger,coi-scheduled-submission-trigger,cronjob-data-governance,digital-tool-box-commons,digital-tool-box-models,digital-toolbox-app-gateway,digital-toolbox-svc-productassets,dtb-be,dtb-be-reader,dtb-content-syndication-trigger,dtb-fe-react-v1,dtb-integrity-trigger,dtb-manual-syndication-trigger,dtb-notification-service,dtb-rr-translate,dtb-rr-translate-reviews-from-tapi-trigger,dtb-rr-translate-reviews-to-tapi-trigger,dtb-static-content-automation,dtb-static-content-server,dtb-svc-common-utils,dtb-svc-user-login,dtb-update-definition-lock-trigger,dtb-utility,rr-creator,rr-updater,run-dtb-notification-creator-dev,run-k8s-bv-reader,run-k8s-rr-creator,run-k8s-rr-updater,svc-data-governance,PR_analyser,docdb-dtb-ratings

# ── JIRA ──────────────────────────────────────────────────────────────────────
# Project key prefix(es), comma-separated
JIRA_PROJECT_KEYS=DTB

# ── Performance ───────────────────────────────────────────────────────────────
MAX_PARALLEL=4
REF_CACHE_TTL=600
