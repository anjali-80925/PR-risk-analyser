# ── PR Risk Analyser — Configuration ──────────────────────────────────────────
# Generated by: bash scripts/init.sh
# Docs: see readme.md

# ── Git Provider ──────────────────────────────────────────────────────────────
# Supported: bitbucket-server | bitbucket-cloud | github | gitlab
GIT_PROVIDER=github

# Base URL for repo cloning (SSH or HTTPS)
REPO_BASE_URL=git@github.com:digital-adidas

# ── Services ──────────────────────────────────────────────────────────────────
# Discovery mode: manual (uses SERVICES list) | auto (scans workspace .git dirs)
SERVICE_DISCOVERY_MODE=manual

# Comma-separated repo names (used when SERVICE_DISCOVERY_MODE=manual)
SERVICES=b2bdtb-digital-toolbox-svc-marketingassets,b2bdtb-dtb-iconography-service,b2bdtb-digital-toolbox-svc-ratingsandreviews,b2bdtb-coi-offline-download-trigger,b2bdtb-coi-scheduled-submission-trigger,b2bdtb-digital-toolbox-cronjob-data-governance,b2bdtb-digital-tool-box-commons,b2bdtb-digital-tool-box-models,b2bdtb-digital-toolbox-app-gateway,b2bdtb-digital-toolbox-svc-productassets,b2bdtb-dtb-be,b2bdtb-dtb-bv-reader,b2bdtb-dtb-content-syndication-trigger,b2bdtb-dtb-fe-react-v1,b2bdtb-dtb-integrity-trigger,b2bdtb-dtb-manual-syndication-trigger,b2bdtb-dtb-rr-translate,b2bdtb-dtb-rr-translate-reviews-from-tapi-trigger,b2bdtb-dtb-rr-translate-reviews-to-tapi-trigger,b2bdtb-dtb-static-content-automation,b2bdtb-dtb-static-content-server,b2bdtb-digital-toolbox-svc-common-utils,b2bdtb-digital-toolbox-svc-user-login,b2bdtb-dtb-update-definition-lock-trigger,b2bdtb-dtb-utility,b2bdtb-dtb-rr-creator,b2bdtb-dtb-rr-updater,b2bdtb-dtb-odp-utility,b2bdtb-digital-toolbox-svc-data-governance,b2bdtb-dtb-ratings-iac

# ── JIRA ──────────────────────────────────────────────────────────────────────
# Project key prefix(es), comma-separated
JIRA_PROJECT_KEYS=DTB

# ── Test Automation Repo ──────────────────────────────────────────────────────
# Repo name of the automation test suite (URL = REPO_BASE_URL/TEST_REPOS)
# Leave blank to disable test selection (Mode 2)
TEST_REPOS=b2bdtb-dtb-automated-tests

# ── Performance ───────────────────────────────────────────────────────────────
MAX_PARALLEL=4
REF_CACHE_TTL=600
